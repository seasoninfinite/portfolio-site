# =============================================================================
# Copy to `.env.local` and fill in real values. Never commit `.env.local`.
# Windows (PowerShell): Copy-Item .env.example .env.local
# Windows (CMD):        copy .env.example .env.local
# =============================================================================

# -----------------------------------------------------------------------------
# Public site URL (no trailing slash) — used for SEO metadata, sitemap, JSON-LD.
# On Netlify you can set this to your primary domain, e.g. https://yoursite.netlify.app
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_SITE_URL=https://your-production-domain.com

# -----------------------------------------------------------------------------
# Stripe (server-only — required for checkout + webhooks)
# Get keys from: https://dashboard.stripe.com/apikeys
# -----------------------------------------------------------------------------
# Secret key (starts with sk_test_ or sk_live_)
STRIPE_SECRET_KEY=

# Webhook signing secret (starts with whsec_) — Stripe Dashboard → Developers → Webhooks
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Stripe price IDs (optional — defaults are in src/lib/stripe-config.ts)
# Uncomment to override per environment without editing code:
# -----------------------------------------------------------------------------
# STRIPE_PRICE_BASIC=
# STRIPE_PRICE_STANDARD=
# STRIPE_PRICE_PREMIUM=
# STRIPE_PRICE_CARE=

# -----------------------------------------------------------------------------
# Optional: publishable key if you add client-side Stripe.js / Elements later
# -----------------------------------------------------------------------------
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
