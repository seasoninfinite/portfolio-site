# Cloudflare R2 Configuration for Video Migration
# Copy this file to .env and fill in your actual values

# Your Cloudflare Account ID (found in Cloudflare dashboard)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Your Cloudflare API Token (create with R2 permissions)
# Generate at: https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=your_api_token_here

# The name of your R2 bucket
R2_BUCKET_NAME=portfolio-videos

# Your custom domain for R2 (optional, otherwise uses default R2 URL)
# Example: https://cdn.yourdomain.com
R2_CUSTOM_DOMAIN=

# The local path to your videos (relative to project root)
LOCAL_VIDEO_PATH=public/work/loops